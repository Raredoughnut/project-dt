# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# ── Supabase Postgres (개발·운영 공용) ──
# Supabase 대시보드 → Connect → "Session pooler" URI 복사 → [DB-PASSWORD] 교체.
# 끝에 ?sslmode=require 를 반드시 포함(Supabase는 TLS 필수).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# ── Supabase Storage (배너 이미지 업로드, 공개 버킷) ──
# Supabase 대시보드 → Storage 에서 Public 버킷을 하나 만든다(기본 이름 'banners').
# 값은 Settings → API 에서 확인.
#   SUPABASE_URL: Project URL (예: https://<project-ref>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY: service_role 키 (⚠️ 서버 전용, 절대 클라이언트 노출 금지)
#   SUPABASE_STORAGE_BUCKET: 배너 버킷 이름 (선택, 기본 'banners')
#   SUPABASE_IMAGES_BUCKET: 테스트 대표/결과카드 이미지 버킷 (선택, 기본 'images')
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=banners
SUPABASE_IMAGES_BUCKET=images

# ── (선택) 로컬 Docker Postgres 폴백 ──
# 오프라인 개발이 필요할 때만. docker-compose.yml 로 로컬 PG를 띄우고 위 DATABASE_URL 을 아래로 교체:
#   DATABASE_URL=postgres://rd_admin:donut46@localhost:5433/project_dt
# (docker-compose 가 읽는 값)
#   POSTGRES_DB=project_dt
#   POSTGRES_USER=rd_admin
#   POSTGRES_PASSWORD=change-me
#   POSTGRES_PORT=5433
