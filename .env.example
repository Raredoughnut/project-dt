# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# ── Local Postgres (Docker Compose) ──
POSTGRES_DB=project_dt
POSTGRES_USER=rd_admin
POSTGRES_PASSWORD=change-me
# 호스트 5432가 이미 점유돼 있으면 5433 등으로 변경하고 DATABASE_URL 포트도 맞추세요.
POSTGRES_PORT=5432

# ── App DB connection ──
# 로컬(호스트에서 앱 실행)  → host = localhost
# 프로덕션(앱도 컨테이너)    → host = 서비스명(db)
DATABASE_URL=postgres://rd_admin:change-me@localhost:5432/project_dt
